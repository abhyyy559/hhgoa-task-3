# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Steps for each value: see HUMAN_ACTIONS.md

# H1 — Google Cloud Vision API key (billing enabled on the GCP project)
GOOGLE_VISION_API_KEY=

# H2 — Pinata API JWT (for IPFS pinning)
PINATA_JWT=
# Optional: your dedicated Pinata gateway
PINATA_GATEWAY=

# H3 — Polygon Amoy testnet wallet (throwaway testnet wallet ONLY)
AMOY_PRIVATE_KEY=
AMOY_WALLET_ADDRESS=

# Polygon Amoy RPC endpoints (verified working Sept 2026; first is primary)
AMOY_RPC_URL=https://polygon-amoy.drpc.org
AMOY_RPC_FALLBACK=https://polygon-amoy-bor-rpc.publicnode.com

# Optional — only if Phase 0 shows thin Vision coverage (H7)
SERPAPI_KEY=
